# ──────────────────────────────────────────────────────────────
# .env.example  —  copy this to .env and fill in your values
# NEVER commit .env to version control
# ──────────────────────────────────────────────────────────────

# AWS credentials (IAM user with s3:PutObject / s3:GetObject on the bucket)
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY_HERE
AWS_DEFAULT_REGION=us-east-2

# S3 target
S3_BUCKET=lakehousedata-638442050476-us-east-2-an
S3_PREFIX=lakehouse/gold

# Azure SQL Managed Instance / Azure SQL DB target for workspace performance demo
# Authentication uses the currently signed-in Azure CLI account.
AZURE_SQL_SERVER=temalo-mi.public.72232dac5390.database.windows.net,3342
AZURE_SQL_DATABASE=GenslerData
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server
AZURE_SQL_SCHEMA=workspace
